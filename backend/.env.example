# PostgreSQL connection string (Supabase / Neon / Render Postgres / local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/military_asset_db?schema=public"

# JWT
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="8h"

# Server
PORT=5000
NODE_ENV=development

# Comma-free single origin (your deployed frontend URL) or * for dev
CORS_ORIGIN="http://localhost:5173"
